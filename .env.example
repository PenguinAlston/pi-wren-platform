# --- API (apps/api) ---
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (services/data-engine) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=piwren
DB_USER=demo
DB_PASSWORD=demo

# --- WrenAI CLI（受治理语义层，必配）---
# WREN_BIN 指向 wren 可执行（默认 'wren'，可填绝对路径）
# WREN_PROJECT_DIR 指向 wren_project.yml 所在目录（默认仓库 semantic/wren）
# 服务器需先 pip install 'wrenai[postgres,memory]' 并在 semantic/wren 下执行：
#   wren context build && wren memory index
WREN_BIN=wren
WREN_PROJECT_DIR=semantic/wren

# --- LLM provider（必配：SQL 生成与摘要均依赖 LLM）---
# 完全拥抱 WrenAI 后不再有离线 mock 兜底，LLM_PROVIDER 不能为 mock
# Values: openai | anthropic | ollama
LLM_PROVIDER=openai
# OpenAI-compatible (works with OpenAI, DeepSeek, DashScope, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Session & Custom Agents ---
# 会话 jsonl 持久化目录（开源 Pi）
# SESSION_DIR=data/sessions
# 自定义 Agent 管理面鉴权（X-Admin-Token）
# ADMIN_TOKEN=
# 连接串加密密钥（≥8 字符，建议 ≥32 字节；配置后才启用自定义 Agent）
# AGENT_SECRET_KEY=
# 管理操作审计主体（sys_user.user_id，默认 UADMIN）
# AUDIT_USER_ID=UADMIN
