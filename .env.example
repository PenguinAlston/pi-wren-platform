# --- API (apps/api) ---
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (services/data-engine) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=piwren
DB_USER=demo
DB_PASSWORD=demo

# --- Semantic layer ---
# MDL 式语义配置目录（默认 ./semantic）
# SEMANTIC_DIR=

# --- Wren AI (services/context-engine) ---
WREN_URL=http://localhost:8000
WREN_TOKEN=

# --- LLM provider (packages/agent-sdk) ---
# 配置为真实 provider 时：SQL 生成 + 结果摘要均由 LLM 完成（规则引擎自动降级兜底）；
# mock 模式：SQL 使用 MDL 规则匹配，摘要使用确定性分析
# Values: mock | openai | anthropic | ollama
LLM_PROVIDER=mock
# OpenAI-compatible (works with OpenAI, DeepSeek, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
