# --- 后端（backend/，Python FastAPI，pydantic-settings 自动加载本文件）---
PORT=8080
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL（asyncpg 连接，backend/app/data/db.py）---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=piwren
DB_USER=demo
DB_PASSWORD=demo

# --- WrenAI（受治理语义层，进程内 SDK）---
# WREN_PROJECT_DIR 指向 wren_project.yml 所在目录（默认仓库 semantic/wren）
# 服务器需先 pip install 'wrenai[postgres,memory]' 并在 semantic/wren 下执行：
#   wren context build && wren memory index
WREN_PROJECT_DIR=semantic/wren
# strict mode：fail-closed 表白名单 + 数据外读函数拦截（read_csv/dblink 等）；升级 wrenai 后跑 backend/tests/test_golden_sql.py 回归
# WREN_STRICT_MODE=true
# 额外拒绝的函数（逗号分隔，叠加到 wren 内置黑名单）
# WREN_DENIED_FUNCTIONS=

# --- LLM（统一走 OpenAI 兼容接口；SQL 生成与摘要均依赖，必配）---
# base_url 可指向 OpenAI / DashScope / DeepSeek / 本地 vLLM 等任意兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- AI 查询硬约束 ---
# 行数上限（结果超限截断并在回答中提示；防"列出全部保单"打爆内存/前端）
# AI_QUERY_ROW_LIMIT=500
# 语句超时秒数（覆盖 wren 连接器默认 180s，与只读池 command_timeout 对齐）
# AI_QUERY_TIMEOUT_SECONDS=30
# WrenEngine 引擎池大小（每引擎一条 psycopg 连接，并发查询轮询分发）
# AI_ENGINE_POOL_SIZE=4

# --- 限流（滑动窗口；0 = 关闭）---
# 每用户/ IP 每分钟聊天请求上限（LLM 成本防护）
# RATE_LIMIT_CHAT_PER_MIN=12
# 每 IP 每分钟登录尝试上限（防暴力破解）
# RATE_LIMIT_LOGIN_PER_MIN=10

# --- Redis（可选；限流共享态）---
# 配置后限流切 Redis ZSET 共享后端（多副本一致）；连接失败自动降级进程内存
# REDIS_URL=redis://redis:6379/0

# --- 可观测性（可选）---
# Prometheus 抓取令牌：/api/metrics 可用 X-Metrics-Token 头绕过 admin 会话鉴权（compose 监控 profile 用）
# METRICS_TOKEN=change-me-scrape-token
# Sentry 错误追踪：配置 DSN 即启用（后端 sentry-sdk[fastapi]；编排层 @sentry/node 同名变量）
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- 用户认证（生产环境必须开启）---
# AUTH_ENABLED=true 时聊天/会话/传统查询均需登录（HMAC 会话 Cookie + PBKDF2 口令）
# 开启要求：配置 AUTH_SECRET（≥16 字符）；用户表为空时首次启动需 AUTH_ADMIN_PASSWORD（≥8 位）引导创建管理员
# AUTH_ENABLED=false
# AUTH_SECRET=
# AUTH_ADMIN_USERNAME=admin
# AUTH_ADMIN_PASSWORD=
# AUTH_SESSION_HOURS=12

# --- Session & Custom Agents ---
# 自定义 Agent 管理面鉴权（X-Admin-Token；登录 admin 会话亦可）
# ADMIN_TOKEN=
# 连接串加密密钥（≥8 字符，建议 ≥32 字节；配置后才启用自定义 Agent）
# AGENT_SECRET_KEY=
# 管理操作审计主体（sys_operation_log.user_id 默认值）
# AUDIT_USER_ID=UADMIN

# --- Pi 编排层（M1，可选）---
# 开启后 /chat 页出现"Pi 编排"开关（多工具编排底座）；不配置则该功能 503 优雅降级
# PI_ORCHESTRATOR_URL=http://127.0.0.1:8090
# INTERNAL_API_TOKEN=change-me-to-a-random-token
# PI_PORT=8090
# PY_BACKEND_URL=http://127.0.0.1:8080

# --- 远程 embedding 语义检索（可选，优先于本地 WrenMemory）---
# OpenAI 兼容 /embeddings 端点 + 模型（如 DashScope text-embedding-v3，复用 OPENAI_API_KEY）；
# 配置后语义上下文走远程向量检索（含相似 SQL 示例召回），零本地模型内存；
# 不配置且 WREN_MEMORY_ENABLED=false 时降级为 MDL 直读
# WREN_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# WREN_EMBEDDING_API_KEY=同 OPENAI_API_KEY 即可
# WREN_EMBEDDING_MODEL=text-embedding-v3
